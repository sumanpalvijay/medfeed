import { Account } from './pages/account';
import { Auth } from './pages/auth';
import { Home } from './pages/home';

export default function App() {
  return (
    <Routes>
      <Route path="/" element={<Home />} />
      <Route path="/auth/:pathname" element={<Auth />} />
      <Route path="/account/:pathname" element={<Account />} />
    </Routes>
  );
}`,language:"tsx"},{value:"home.tsx",label:"src/pages/home.tsx",codeSnippet:`import {
  RedirectToSignIn,
  SignedIn,
  UserButton,
} from '@neondatabase/neon-js/auth/react/ui';

export function Home() {
  return (
    <>
      <SignedIn>
        <div
          style={{
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'center',
            alignItems: 'center',
            minHeight: '100vh',
            gap: '2rem',
          }}
        >
          <div style={{ textAlign: 'center' }}>
            <h1>Welcome!</h1>
            <p>You're successfully authenticated.</p>
            <UserButton />
          </div>
        </div>
      </SignedIn>
      <RedirectToSignIn />
    </>
  );
}`,language:"tsx"},{value:"auth.tsx",label:"src/pages/auth.tsx",codeSnippet:`import { AuthView } from '@neondatabase/neon-js/auth/react/ui';
import { useParams } from 'react-router-dom';

export function Auth() {
  const { pathname } = useParams();
  return (
    <div
      style={{
        display: 'flex',
        justifyContent: 'center',
        alignItems: 'center',
        minHeight: '100vh',
      }}
    >
      <AuthView pathname={pathname} />
    </div>
  );
}`,language:"tsx"},{value:"account.tsx",label:"src/pages/account.tsx",codeSnippet:`import { AccountView } from '@neondatabase/neon-js/auth/react/ui';
import { useParams } from 'react-router-dom';

export function Account() {
  const { pathname } = useParams();
  return <AccountView pathname={pathname} />;
}`,language:"tsx"}]},Sts=()=>c.jsx(c.Fragment,{children:c.jsx($Nt,{snippetOption:xts,height:"fit"})}),Nts="_container_g51nv_1",Rts="_section_g51nv_8",Dts="_codeBlock_g51nv_14",Tts="_list_g51nv_18",qy={container:Nts,section:Rts,codeBlock:Dts,list:Tts},vZ="@neondatabase/neon-js",xZ="react-router-dom",_ts={npm:`npm install ${vZ} ${xZ}`,yarn:`yarn add ${vZ} ${xZ}`,bun:`bun add ${vZ} ${xZ}`,pnpm:`pnpm add ${vZ} ${xZ}`},kts={npm:"npm create vite@latest my-neon-app -- --template react-ts",yarn:"yarn create vite my-neon-app --template react-ts",bun:"bun create vite my-neon-app --template react-ts",pnpm:"pnpm create vite my-neon-app --template react-ts"},Lts={npm:"npm run dev",yarn:"yarn dev",bun:"bun run dev",pnpm:"pnpm dev"},Mts=({integration:s})=>{const[a,A]=L.useState("pnpm"),d=s.base_url;return c.jsxs("div",{className:qy.container,children:[c.jsx(JT,{header:"Create a react app with Vite",icon:"lightning",children:c.jsxs("div",{className:qy.section,children:["Run the following command to create a react application with Vite:",c.jsx(oBe,{manager:a,commands:kts,onSelectionChange:A})]})}),c.jsx(yR,{label:"or add to existing app"}),c.jsx(JT,{header:c.jsxs(c.Fragment,{children:["Install ",c.jsx(xi,{children:"@neondatabase/neon-js"})]}),stepNumber:1,children:c.jsxs("div",{className:qy.section,children:[c.jsxs(bt,{children:["The ",c.jsx(xi,{children:"neon-js"})," SDK is a unified client for managing authentication and users with intuitive interface."]}),c.jsx(oBe,{manager:a,commands:_ts,onSelectionChange:A})]})}),c.jsx(JT,{header:"Configure environment variables",stepNumber:2,children:c.jsxs("div",{className:qy.section,children:[c.jsxs(bt,{children:["Add the Neon Auth URL to your ",c.jsx(xi,{children:".env"})," file. Create the file if it doesn't exist."]}),c.jsx(cg,{className:qy.codeBlock,children:`VITE_NEON_AUTH_URL=${d??""}`})]})}),c.jsx(JT,{header:"Initialize the client",stepNumber:3,children:c.jsxs("div",{className:qy.section,children:[c.jsxs(bt,{children:["Create a new fi