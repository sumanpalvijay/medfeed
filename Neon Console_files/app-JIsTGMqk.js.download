  query listPrincipals($accountId: String, $filter: String)
  @component(name: "IdentityMgmt.UserGroup") {
    aclmanagerIdentityapiListPrincipals(
      input: {
        accountId: $accountId
        filter: $filter
        includeAccountIdentities: false
        includeWorkspaceIdentities: true
        includeGroups: true
        includeServicePrincipals: true
        includeUsers: true
      }
    ) {
      apiError {
        message
      }
      principals {
        user {
          userName
          principal {
            displayName
          }
        }
        group {
          groupName
        }
        servicePrincipal {
          applicationId
          principal {
            displayName
          }
        }
      }
